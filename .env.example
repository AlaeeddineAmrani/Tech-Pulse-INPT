PORT=2500

# Base de données (par défaut : conteneur MongoDB local)
MONGO_URI=mongodb://mongodb:27017/techpulse

# Optionnel : décommente et remplace si tu veux utiliser MongoDB Atlas
# MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/techpulse

# Token GitHub (nécessaire pour récupérer les métriques des dépôts)
GITHUB_TOKEN=ghp_votre_token_github_ici